name: build-cbg

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  packages: write

env:
  IMAGE: ghcr.io/${{ github.repository_owner }}/cbg

jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4

      - name: Liberar espaco em disco
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          df -h /

      - name: Construir a imagem
        run: sudo podman build -t localhost/cbg:latest -f Containerfile .

      - name: Publicar no GHCR
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          IMAGE_LC=$(echo "$IMAGE" | tr '[:upper:]' '[:lower:]')
          echo "$GH_TOKEN" | sudo podman login ghcr.io -u "${{ github.actor }}" --password-stdin
          sudo podman tag localhost/cbg:latest "$IMAGE_LC:latest"
          sudo podman push "$IMAGE_LC:latest"

      - name: Gerar disco qcow2
        run: |
          mkdir -p output
          sudo podman run --rm --privileged --pull=newer \
            --security-opt label=type:unconfined_t \
            -v ./output:/output \
            -v /var/lib/containers/storage:/var/lib/containers/storage \
            quay.io/centos-bootc/bootc-image-builder:latest \
            --type qcow2 --rootfs xfs --local localhost/cbg:latest

      - name: Guardar o disco como artefato
        uses: actions/upload-artifact@v4
        with:
          name: cbg-qcow2
          path: output/qcow2/disk.qcow2
          retention-days: 3
          compression-level: 0
